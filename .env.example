# ─────────────────────────────────────────────
# LinkEDtohome — Landing Page
# Copy this file and rename to match the target environment:
#   .env.localhost    → npm run dev          (local backend)
#   .env.development  → npm run dev:development (dev server)
#   .env.staging      → npm run dev:staging / build:staging
#   .env.production   → npm run build:production
# ─────────────────────────────────────────────

# Backend API base URL (required)
VITE_API_BASE_URL=http://localhost:3000/api

# App display name
VITE_APP_NAME=LinkEDtohome

# School dashboard URL — used for "Register" links on the Pricing page
VITE_APP_URL=http://localhost:5174
